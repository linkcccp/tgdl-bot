# ============================================================
# tgdl-bot v2 环境变量配置示例
# 用法：cp .env.example .env  → 填写 → docker compose up -d
# 必填项：TGDL_BOT_TOKEN / TGDL_TARGET_CHANNELS / TGDL_ALLOWED_USERS
#         TGDL_API_ID / TGDL_API_HASH
# ============================================================

# Bot Token（@BotFather 创建后获得）
TGDL_BOT_TOKEN=123456789:AAAA-BBBB_ccccdddd_eeeee

# 目标频道/群组 ID（逗号分隔，支持负数）
TGDL_TARGET_CHANNELS=-1001234567890

# 允许在私聊中使用的用户 ID（逗号分隔）
TGDL_ALLOWED_USERS=123456789

# Telegram API ID / API Hash（本地 Bot API Server 凭据，my.telegram.org）
TGDL_API_ID=123456
TGDL_API_HASH=abcdef0123456789abcdef0123456789

# ---- 以下均为可选 ----
# 日志级别：Trace / Debug / Info / Warn / Error
# TGDL_LOG_LEVEL=Info

# 最大并发下载数
# TGDL_MAX_CONCURRENT=2

# 下载/上传重试与超时
# TGDL_DOWNLOAD_RETRIES=3
# TGDL_UPLOAD_RETRIES=2
# TGDL_DOWNLOAD_TIMEOUT=3600

# 是否提取音频（mp3）
# TGDL_EXTRACT_AUDIO=false

# 私聊请求者是否也接收媒体
# TGDL_SEND_TO_REQUESTER=false

# 是否允许播放列表 / 是否允许私网 URL（默认均拒绝，SSRF 防护）
# TGDL_ALLOW_PLAYLISTS=false
# TGDL_ALLOW_PRIVATE_URLS=false

# 合并容器格式（/ 分隔候选，优先 mp4，封装不了自动退 mkv）
# TGDL_MERGE_FORMAT=mp4/mkv

# 最大媒体字节数
# TGDL_MAX_MEDIA_SIZE=1900000000

# 下载站点 cookies（通过 bot 私聊 /cookie 上传，按域名自动选用）
# 默认存于 /opt/tgdl-bot/api-data/cookies（tgdl-data 卷内，跨镜像重建持久；一般无需改动）
# TGDL_COOKIE_STORE_DIR=/opt/tgdl-bot/api-data/cookies

# yt-dlp 代理（数据中心 IP 被站点拦截时可配置）
# TGDL_YTDLP_PROXY=http://127.0.0.1:7890

# yt-dlp 附加参数（按空白拆分，如免 cookies 绕过 YouTube 机器人检测）
# TGDL_YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android,ios

# YouTube 多 player_client（仅 YouTube 生效，默认 android,ios,web_embedded,tv；
# 不含 default(web)：其对部分视频返回不完整格式表，会导致 "Requested format is not available"；
# 设为空可禁用）
# TGDL_YTDLP_PLAYER_CLIENTS=android,ios,web_embedded,tv

# 非交互场景（频道/群组发链接、或私聊选择超时）的默认下载模式：video（合并）/ audio（仅音频）
# TGDL_DEFAULT_MODE=video

# Bot 全局默认语言：auto（跟随用户 language_code）/ en / zh（缺省 auto，即中文用户中文、国际用户英文）
# 交互式安装向导会自动写入向导所选语言
# TGDL_LANGUAGE=auto

# 运行时状态目录：languages.json / config-overlay.json / access-overlay.json / pending-notify.json
# 默认 /opt/tgdl-bot/api-data（tgdl-data 卷内，跨镜像重建持久；一般无需改动）
# TGDL_STATE_DIR=/opt/tgdl-bot/api-data

# 下载模式：私聊发链接时，仅音频自动下载 flac+mp3 双传；
# 含视频会在私聊内用按钮选择「视频+音频 / 仅音频」。

# /update 是否更新 yt-dlp / ffmpeg
# TGDL_UPDATE_YTDLP=true
# TGDL_UPDATE_FFMPEG=true

# 若想完全用文件管理配置：把 config.conf 挂载到容器，并设置：
# TGDL_CONFIG_FILE=/opt/tgdl-bot/config.conf   （挂载该路径的卷即可，无需填上面的必填项）
