[Unit]
Description=Telegram Local Bot API Server (--local mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgdl-bot
Group=tgdl-bot
EnvironmentFile=/opt/tgdl-bot/api.env
WorkingDirectory=/opt/tgdl-bot
ExecStart=/opt/tgdl-bot/api/telegram-bot-api --api-id=${API_ID} --api-hash=${API_HASH} --local --dir=/var/lib/tgdl-bot-api --http-port=8081 --max-webhook-connections=100 --log=/var/log/tgdl-bot-api.log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/var/lib/tgdl-bot-api /var/log

[Install]
WantedBy=multi-user.target
