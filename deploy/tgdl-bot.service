[Unit]
Description=TGDL Bot - Telegram download bot (yt-dlp + local Bot API Server)
Documentation=https://github.com/
After=network-online.target telegram-bot-api.service
Wants=telegram-bot-api.service

[Service]
Type=simple
User=tgdl-bot
Group=tgdl-bot
WorkingDirectory=/opt/tgdl-bot
ExecStart=/opt/tgdl-bot/tgdl-bot
Restart=on-failure
RestartSec=5
# PATH 优先使用自更新后的二进制目录
Environment=PATH=/opt/tgdl-bot/bin:/usr/local/bin:/usr/bin:/bin
# 内存限制：低于目标即可（软限制）
MemoryMax=220M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
ReadWritePaths=/opt/tgdl-bot /var/lib/tgdl-bot

[Install]
WantedBy=multi-user.target
